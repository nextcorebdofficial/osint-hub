# Copy to .env and fill in what you have. Everything is optional unless marked.

# --- Access control -------------------------------------------------------
# Require a password to use the app. REQUIRED for anything other than your own laptop.
APP_PASSWORD=
# Random string used to sign the login cookie and to key the audit-log hashes.
# Keep it stable across restarts: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# --- Who runs this instance (shown on /legal/* pages) ---------------------
# REQUIRED if other people use your instance. The legal pages show a warning until all three are set.
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_JURISDICTION=

# --- Data minimisation ----------------------------------------------------
# Delete saved cases older than this many days (0 = keep forever). 30 is a good value for shared instances.
CASE_RETENTION_DAYS=0
# Audit log: time, type, purpose and a keyed hash of the target (never the target or IP).
# Default is audit.log next to main.py. Set to empty to turn it off.
# AUDIT_LOG=

# --- Abuse protection -----------------------------------------------------
# Requests per IP per minute
RATE_LIMIT_HEAVY=20
RATE_LIMIT_GENERAL=300

# --- Optional API keys (features stay off without them) --------------------
HIBP_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# SEC EDGAR asks for a contact in the User-Agent, e.g. "MyOrg admin@example.com"
SEC_USER_AGENT=

# Where cases are stored (default: osint.db next to main.py)
# DB_PATH=
