{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["data.json", "extra_tools.json", "github_tools.json", "templates/**", "docs/legal/**"],
        "maxLambdaSize": "100mb"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "main.py" }]
}
