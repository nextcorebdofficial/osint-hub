# Copy to .env and fill in what you have. Everything is optional unless marked.

# --- Access control -------------------------------------------------------
# Require a password to use the app. REQUIRED for anything other than your own laptop.
APP_PASSWORD=
# Random string used to sign the login cookie and to key the audit-log hashes.
# Keep it stable across restarts: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# --- Accounts (email + password, recommended for public instances) --------
# AUTH_MODE=accounts turns on a public home page, sign-up and per-user cases.
AUTH_MODE=
# open (anyone can sign up), invite (only ALLOWED_EMAILS / ALLOWED_EMAIL_DOMAINS) or closed
REGISTRATION=open
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
# Investigations per account per day (0 = unlimited)
DAILY_INVESTIGATIONS=100
# The public address of this site. Required on Vercel: links in emails are built from it.
PUBLIC_URL=
# Email for confirmation and password reset links. Free tiers: resend.com, brevo.com, or any SMTP server.
MAIL_PROVIDER=
MAIL_FROM=NextCore BD <no-reply@example.org>
MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Persistent database for serverless hosts (free at turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Name shown in the header, emails and legal pages
BRAND_NAME=NextCore BD

# --- Who runs this instance (shown on /legal/* pages) ---------------------
# REQUIRED if other people use your instance. The legal pages show a warning until all three are set.
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_JURISDICTION=

# --- Data minimisation ----------------------------------------------------
# Delete saved cases older than this many days (0 = keep forever). 30 is a good value for shared instances.
CASE_RETENTION_DAYS=0
# Audit log: time, type, purpose and a keyed hash of the target (never the target or IP).
# Default is audit.log next to main.py. Set to empty to turn it off.
# AUDIT_LOG=

# --- Abuse protection -----------------------------------------------------
# Requests per IP per minute
RATE_LIMIT_HEAVY=20
RATE_LIMIT_GENERAL=300

# --- Optional API keys (features stay off without them) --------------------
HIBP_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# SEC EDGAR asks for a contact in the User-Agent, e.g. "MyOrg admin@example.com"
SEC_USER_AGENT=

# Where cases are stored (default: osint.db next to main.py)
# DB_PATH=
