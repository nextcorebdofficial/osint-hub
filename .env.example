# Copy to .env and fill in what you have. Everything is optional.

# Require a password to use the app (strongly recommended on any public server)
APP_PASSWORD=
# Random string used to sign the login cookie; keep it stable across restarts
APP_SECRET=

# Rate limits per IP per minute
RATE_LIMIT_HEAVY=20
RATE_LIMIT_GENERAL=300

# Optional API keys; features stay disabled without them
HIBP_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# SEC EDGAR asks for a contact in the User-Agent, e.g. "MyOrg admin@example.com"
SEC_USER_AGENT=

# Where cases are stored (default: osint.db next to main.py)
# DB_PATH=
